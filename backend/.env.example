# Copy this template to backend/.env and fill in the empty secret values locally.
# Empty values are deliberate placeholders; do not commit real credentials here.
# Current pipeline: GOOGLE_API_KEY or GEMINI_API_KEY. Manual API also needs PORTFOLIO_INGESTION_TOKEN.

# Optional: defaults already allow the local Angular development server.
# Origins contain scheme, hostname, and port, without the /PortfolioWebApp path.
PORTFOLIO_CORS_ORIGINS='["http://127.0.0.1:4200","http://localhost:4200"]'
PORTFOLIO_HOST=127.0.0.1
PORTFOLIO_PORT=8000
# Vercel sets this automatically through vercel.json; leave local development as local.
PORTFOLIO_RUNTIME=local

# Required for embeddings and answers. Put the real key only in backend/.env.
# GOOGLE_API_KEY is also accepted; set one key name consistently.
# https://aistudio.google.com/api-keys
# GitHub: Actions secret GOOGLE_API_KEY (GEMINI_API_KEY is also supported).
# Vercel: backend environment variable GOOGLE_API_KEY or GEMINI_API_KEY.
GEMINI_API_KEY=
# GitHub: optional Actions variable GEMINI_EMBEDDING_MODEL.
# Vercel: backend environment variables for both model names.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GitHub: optional Actions variable PORTFOLIO_EMBEDDING_DIMENSIONS.
PORTFOLIO_EMBEDDING_DIMENSIONS=768
PORTFOLIO_EMBEDDING_BATCH_SIZE=32

# Generate your own private random token for the local POST /api/ingest endpoint.
# Hosted refreshes use the manual GitHub workflow and a new deployment instead.
PORTFOLIO_INGESTION_TOKEN=

# Relative paths are resolved from backend/, regardless of the shell directory.
# Vercel overrides these two paths with the packaged content and a writable /tmp copy.
PORTFOLIO_CONTENT_DIR=../content
PORTFOLIO_INDEX_DIR=data/generated-index
PORTFOLIO_SITE_URL=https://hulk914.github.io/PortfolioWebApp/
PORTFOLIO_CHUNK_SIZE=1200
PORTFOLIO_CHUNK_OVERLAP=150
PORTFOLIO_RETRIEVAL_TOP_K=6
# Cosine similarity, not a confidence percentage. Tune with `uv run retrieve`.
PORTFOLIO_RETRIEVAL_MIN_SCORE=0.3
PORTFOLIO_PROVIDER_TIMEOUT_SECONDS=30
# Total chat attempts including the first call; retries only temporary HTTP 5xx.
PORTFOLIO_CHAT_MAX_ATTEMPTS=3
PORTFOLIO_MAX_OUTPUT_TOKENS=1200

# Optional private LangSmith tracing. Legacy LANGCHAIN_* equivalents are accepted.
# LANGCHAIN_TRACING / LANGCHAIN_TRACING_V2 are aliases for LANGSMITH_TRACING.
# Keys stay on the backend; traces are never automatically made public.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=portfoliowebapp-local
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
# Set only if your API key needs an explicit LangSmith workspace.
LANGSMITH_WORKSPACE_ID=

# Deployment from GitHub Actions; store these three in repository Actions secrets.
# These deployment credentials/IDs are not needed by the running FastAPI app.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
# Optional GitHub Actions variable; default is the stable production alias below.
# BACKEND_PRODUCTION_URL=https://portfolio-web-app-six-sage.vercel.app
