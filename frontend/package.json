{
  "name": "@portfolio/frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prestart": "npm run prepare:frontend",
    "start": "ng serve --host 127.0.0.1 --port 4200",
    "dev": "npm run start",
    "validate:content": "node tools/validate-content.mjs",
    "prepare:frontend": "npm run validate:content && node tools/prepare-frontend.mjs",
    "build": "node tools/build.mjs",
    "build:pages": "node tools/build.mjs --base-href /PortfolioWebApp/",
    "preview": "node tools/preview.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/platform-server": "22.3.0",
    "@angular/router": "22.3.0",
    "@angular/ssr": "22.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "ajv": "8.20.0",
    "prettier": "3.10.1",
    "typescript": "~6.0.0"
  },
  "description": "Angular portfolio powered by shared JSON content.",
  "engines": {
    "node": "^24.15.0"
  }
}
